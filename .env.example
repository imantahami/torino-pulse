# Copy this file to `.env` (already gitignored) and fill in real values.
# `.env` is loaded automatically by `docker compose`.

# Required — no default on purpose, so the stack fails loudly instead of
# falling back to a weak password if this is left unset.
# Used by: the postgres container, every Airflow service (DB conn strings +
# the DAGs' own psycopg2 connections via POSTGRES_PASSWORD).
POSTGRES_PASSWORD=changeme

# Required — read by dbt via profiles.yml's env_var('DBT_PASSWORD').
# In this project dbt connects with the same credentials as Airflow, so this
# should match POSTGRES_PASSWORD above.
DBT_PASSWORD=changeme

# Optional — Airflow UID on Linux hosts (avoids root-owned files in
# logs/dags/plugins). See docker-compose.yaml for details.
# AIRFLOW_UID=50000

# Optional — admin account created by airflow-init on first run.
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=changeme
